<?xml version="1.0" encoding="utf-8"?>
<!-- 画面名：感想の1行 -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="0dp"
    app:cardBackgroundColor="@color/mm_background"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="false"
    app:contentPadding="0dp"
    app:strokeColor="@color/mm_border"
    app:strokeWidth="1dp">

    <!-- 感想の表示エリア -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:orientation="vertical">

        <!-- ID・ユーザ名 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_user_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="16dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/mm_item_user_tv_id_text"
                android:textColor="@color/mm_text"
                android:textSize="16sp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_review_user"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/mm_item_review_tv_review_user_text"
                android:textColor="@color/mm_text"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- 感想本文 -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_review_body"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginBottom="16dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:text="@string/mm_item_review_tv_review_body_text"
            android:textColor="@color/mm_text"
            android:textSize="16sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>