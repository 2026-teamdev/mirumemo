<?xml version="1.0" encoding="utf-8"?>
<!-- 画面名：作品の1マス／ボタン→遷移先：呼出元に従う -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardBackgroundColor="@color/mm_list_background"
    app:cardCornerRadius="12dp">
    <!-- 作品画像と情報 -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">
        <ImageView
            android:id="@+id/iv_work_image"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="2:3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:contentDescription="@string/mm_common_iv_work_text"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_image_placeholder" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_work_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_work_image"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/mm_item_work_tv_work_title_text"
            android:textColor="@color/mm_text"
            android:textSize="16sp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_work_genre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_work_title"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/mm_item_work_tv_work_genre_text"
            android:textColor="@color/mm_text"
            android:textSize="14sp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_work_category"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_work_genre"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/mm_item_work_tv_work_category_text"
            android:textColor="@color/mm_text"
            android:textSize="14sp" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
