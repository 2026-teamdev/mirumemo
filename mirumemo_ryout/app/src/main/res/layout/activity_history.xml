<?xml version="1.0" encoding="utf-8"?>
<!-- 画面名：履歴
ボタン→遷移先：タブは初期状態で先頭のいいねを選択。切替処理なし
ボトムナビ：nav_mypage→MyPageActivity／nav_record→RecordActivity／nav_history→HistoryActivity／nav_profile→ProfileActivity／nav_admin_works→AdminWorksActivity／nav_admin_users→AdminUsersActivity／nav_admin_stats→AdminStatsActivity／nav_admin_genres→AdminGenresActivity -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mm_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".HistoryActivity">
    <!-- トップバー -->

    <include
        layout="@layout/layout_top_bar_member" />

    <!-- コンテンツ -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:orientation="vertical">
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabGravity="fill"
            app:tabIndicatorColor="@color/nav_selected"
            app:tabMode="fixed"
            app:tabSelectedTextColor="@color/nav_selected"
            app:tabTextColor="@color/nav_unselected">
            <com.google.android.material.tabs.TabItem
                android:id="@+id/tab_like"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mm_history_tab_like_text" />

            <com.google.android.material.tabs.TabItem
                android:id="@+id/tab_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mm_history_tab_history_text" />
        </com.google.android.material.tabs.TabLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_works"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/mm_list_background"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="3"
            tools:itemCount="6"
            tools:listitem="@layout/item_work" />
    </LinearLayout>

    <!-- ボトムナビゲーション -->

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/mm_background"
        app:itemIconTint="@color/bottom_nav_item_color"
        app:itemTextColor="@color/bottom_nav_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_member_bottom_nav" />
</LinearLayout>
