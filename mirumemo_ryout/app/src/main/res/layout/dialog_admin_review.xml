<?xml version="1.0" encoding="utf-8"?>
<!-- 画面名：感想編集
ボタン→遷移先：各行の編集・削除→同ポップ内／閉じる→AdminWorkDetailActivity -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/mm_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".AdminReviewDialogFragment">
    <!-- コンテンツ -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:padding="16dp"
        android:orientation="vertical">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_reviews"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/mm_list_background"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="3"
            tools:listitem="@layout/item_review" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_close"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:minHeight="48dp"
            android:text="@string/mm_admin_review_btn_close_text"
            android:textColor="@color/mm_on_primary"
            android:textSize="16sp"
            app:backgroundTint="@color/mm_primary"
            app:cornerRadius="12dp" />
    </LinearLayout>
</LinearLayout>
