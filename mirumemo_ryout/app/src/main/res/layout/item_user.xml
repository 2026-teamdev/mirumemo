<?xml version="1.0" encoding="utf-8"?>
<!-- 画面名：ユーザの1行
タップ→AdminUserManageActivity（処理は後工程） -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="0dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/mm_background"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="false"
    app:contentPadding="0dp"
    app:strokeColor="@color/mm_border"
    app:strokeWidth="1dp">

    <!-- 4列を同じ幅で配置 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:weightSum="4">

        <!-- ID -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_user_id"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/mm_item_user_tv_id_text"
            android:textColor="@color/mm_text"
            android:textSize="14sp" />

        <!-- ユーザ名 -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_user_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/mm_item_user_tv_user_name_text"
            android:textColor="@color/mm_text"
            android:textSize="14sp" />

        <!-- 年齢 -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_years"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/mm_item_user_tv_years_text"
            android:textColor="@color/mm_text"
            android:textSize="14sp"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="10sp"
            app:autoSizeMaxTextSize="14sp"
            app:autoSizeStepGranularity="1sp" />

        <!-- 性別：答えたくないも1行で表示 -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_gender"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/mm_item_user_tv_gender_text"
            android:textColor="@color/mm_text"
            android:textSize="14sp"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="10sp"
            app:autoSizeMaxTextSize="14sp"
            app:autoSizeStepGranularity="1sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>