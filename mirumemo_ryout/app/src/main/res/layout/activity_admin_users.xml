<?xml version="1.0" encoding="utf-8"?>
<!-- 画面名：ユーザ情報一覧
ボタン→遷移先：ユーザタップ→AdminUserManageActivity
ボトムナビ：
nav_admin_works→AdminWorksActivity
nav_admin_users→AdminUsersActivity
nav_admin_stats→AdminStatsActivity
nav_admin_genres→AdminGenresActivity
ログアウト→MainActivity
検索：キーボードの検索ボタンで一覧を絞り込む(処理は後工程) -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mm_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".AdminUsersActivity">

    <!-- トップバー -->
    <include
        layout="@layout/layout_top_bar_admin" />

    <!-- コンテンツ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:orientation="vertical">

        <!-- 検索欄 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_search"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:minHeight="48dp"
            android:hint="@string/mm_admin_users_til_search_hint"
            app:boxStrokeColor="@color/mm_primary"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/mm_primary"
            app:endIconMode="clear_text">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="48dp"
                android:minHeight="48dp"
                android:inputType="text"
                android:maxLines="1"
                android:imeOptions="actionSearch"
                android:textColor="@color/mm_text"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 列見出し：一覧と同じ4等分 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:weightSum="4">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_user_id_heading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/mm_admin_users_tv_id_heading_text"
                android:textColor="@color/mm_text"
                android:textSize="14sp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_user_name_heading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/mm_admin_users_tv_user_name_heading_text"
                android:textColor="@color/mm_text"
                android:textSize="14sp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_years_heading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/mm_admin_users_tv_years_heading_text"
                android:textColor="@color/mm_text"
                android:textSize="14sp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_gender_heading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/mm_admin_users_tv_gender_heading_text"
                android:textColor="@color/mm_text"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ユーザ一覧 -->
        <!-- 検索結果の一覧と0件メッセージ -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_users"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/mm_list_background"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="8"
                tools:listitem="@layout/item_user" />

            <TextView
                android:id="@+id/tv_empty_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/mm_common_tv_empty_result_text"
                android:textColor="@color/mm_text"
                android:textSize="14sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- ボトムナビゲーション -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/mm_background"
        app:itemIconTint="@color/bottom_nav_item_color"
        app:itemTextColor="@color/bottom_nav_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_admin_bottom_nav" />
</LinearLayout>